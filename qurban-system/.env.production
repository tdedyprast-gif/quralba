# ============================================
# .env.production — Environment Production
# ============================================
# ⚠️  JANGAN commit file ini ke Git! Sudah ada di .gitignore.
#     Copy dari .env.example dan sesuaikan nilai-nilai di bawah.

# ─── PostgreSQL ───
POSTGRES_USER=qurban_prod
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_32_KARAKTER
POSTGRES_DB=qurban_production

# ─── Go Backend ───
PORT=8004
DATABASE_URL=postgres://qurban_prod:GANTI_DENGAN_PASSWORD_KUAT_32_KARAKTER@db:5432/qurban_production?sslmode=disable

# JWT Secret — buat yang kuat! Contoh generate:
#   openssl rand -hex 64
JWT_SECRET=GANTI_DENGAN_SECRET_64_HEX_KARAKTER

# Admin akun (dibuat otomatis saat pertama start)
ADMIN_EMAIL=admin@qurban.local
ADMIN_PASS=GANTI_DENGAN_PASSWORD_ADMIN_KUAT

# ─── Doit.id Payment ───
# Mode sandbox (default) → tidak ada panggilan HTTP nyata
# Ganti dengan key produksi saat go-live
DOIT_API_KEY=SANDBOX_KEY_REPLACE_ME
DOIT_BASE_URL=https://api.doit.id/v1
DOIT_WEBHOOK_SECRET=SANDBOX_WEBHOOK_SECRET

# ─── Frontend Build ───
# Dibiarkan KOSONG → frontend pakai relative URL
# lewat Nginx reverse proxy (/api/, /ws/, /uploads/)
VITE_API_URL=
