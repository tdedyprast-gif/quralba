# ============================================
# Dockerfile.prod — Frontend React + Vite
# Multi-stage: build → nginx serve
# ============================================

# -------- Stage 1: Build --------
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies (layer caching)
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --production=false

# Copy source dan build
COPY . .

# ARG untuk inject env var saat build time
# VITE_API_URL dikosongkan → frontend pakai relative URL (lewat Nginx reverse proxy)
ARG VITE_API_URL=""
ENV VITE_API_URL=${VITE_API_URL}

RUN yarn build

# -------- Stage 2: Nginx Serve --------
FROM nginx:1.27-alpine

# Hapus default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets dari builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Buat non-root user untuk nginx
RUN addgroup -g 1000 appgroup && \
    adduser -u 1000 -G appgroup -s /bin/sh -D appuser && \
    chown -R appuser:appgroup /usr/share/nginx/html /var/cache/nginx /var/log/nginx

# Nginx perlu listen di port >1024 kalau non-root, atau kita tweak nginx.conf
# Untuk simplicity, kita jalankan nginx sebagai root tapi dengan user worker non-root
# (ini adalah praktik umum untuk nginx official image)

EXPOSE 80

# Health check — cek static file tersedia
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
